# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

require_relative '../node_modules/react-native-permissions/scripts/setup'

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Explicit project — avoids ambiguity when multiple .xcodeproj exist.
project 'FluentFlashcard.xcodeproj'

# Required by firebase-ios-sdk / @react-native-firebase
use_frameworks! :linkage => :static
$RNFirebaseAsStaticFramework = true
# SPM Firebase products are dynamic-only; keep CocoaPods static resolution.
$RNFirebaseDisableSPM = true

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'FluentFlashcard' do
  config = use_native_modules!

  setup_permissions([
    'AppTrackingTransparency',
    'Notifications',
  ])

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # use_frameworks! :static breaks RNPermissions' `#if __has_include("Handler.h")`
    # unless the permission subfolders are on the header search path.
    %w[debug release].each do |config_name|
      xcconfig_path = File.join(
        __dir__,
        'Pods/Target Support Files/RNPermissions',
        "RNPermissions.#{config_name}.xcconfig",
      )
      next unless File.exist?(xcconfig_path)
      contents = File.read(xcconfig_path)
      addition = ' "${PODS_TARGET_SRCROOT}/ios" "${PODS_TARGET_SRCROOT}/ios/AppTrackingTransparency" "${PODS_TARGET_SRCROOT}/ios/Notifications"'
      next if contents.include?('ios/AppTrackingTransparency')
      unless contents.sub!(/^(HEADER_SEARCH_PATHS = .*)$/, "\\1#{addition}")
        contents << "\nHEADER_SEARCH_PATHS = $(inherited)#{addition}\n"
      end
      File.write(xcconfig_path, contents)
      Pod::UI.puts "RNPermissions: patched HEADER_SEARCH_PATHS (#{config_name})".green
    end
  end
end
